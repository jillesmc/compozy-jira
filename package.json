{
  "name": "jira",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && bun build src/index.ts --target=node --outfile=dist/index.js",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "bun test",
    "fake-jira": "bun test/fake-jira-server.ts"
  },
  "dependencies": {
    "@compozy/extension-sdk": "0.7.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^25.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
